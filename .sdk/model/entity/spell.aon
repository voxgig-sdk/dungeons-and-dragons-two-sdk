# Entity: spell

main: kit: entity: spell: {

  alias: field: {}

  fields: [
    {
      name: "casting_time"
      req: false
      type: "`$STRING`"
    }
    {
      name: "classes"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "components"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "desc"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "duration"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "index"
      req: false
      short: "Resource index for the spell"
      type: "`$STRING`"
    }
    {
      name: "level"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "name"
      req: false
      short: "Name of the spell"
      type: "`$STRING`"
    }
    {
      name: "range"
      req: false
      type: "`$STRING`"
    }
    {
      name: "school"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "url"
      req: false
      short: "URL to the spell resource"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "spell"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "Acid Arrow"
                kind: "query"
                name: "name"
                orig: "name"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /spells"
            json: "{\"operationId\":\"getSpells\",\"parameters\":[{\"description\":\"Filter spells by name (e.g., 'Acid Arrow')\",\"example\":\"Acid Arrow\",\"in\":\"query\",\"name\":\"name\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"count\":{\"description\":\"Number of spells returned\",\"type\":\"integer\"},\"results\":{\"items\":{\"properties\":{\"index\":{\"description\":\"Resource index for the spell\",\"type\":\"string\"},\"name\":{\"description\":\"Name of the spell\",\"type\":\"string\"},\"url\":{\"description\":\"URL to the spell resource\",\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/spells"
          segments: [
            {
              lit: "spells"
            }
          ]
          select: {
            exist: [
              "name"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "index"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          contract: {
            id: "GET /spells/{index}"
            json: "{\"operationId\":\"getSpellByIndex\",\"parameters\":[{\"description\":\"The index of the spell to retrieve\",\"in\":\"path\",\"name\":\"index\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"casting_time\":{\"type\":\"string\"},\"classes\":{\"items\":{\"type\":\"object\"},\"type\":\"array\"},\"components\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"desc\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"duration\":{\"type\":\"string\"},\"index\":{\"type\":\"string\"},\"level\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"range\":{\"type\":\"string\"},\"school\":{\"type\":\"object\"},\"url\":{\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response\"},\"404\":{\"description\":\"Spell not found\"}},\"securitySource\":\"unspecified\"}"
            source: "openapi3"
            version: 1
          }
          method: "GET"
          orig: "/spells/{index}"
          rename: {
            param: {
              index: "id"
            }
          }
          segments: [
            {
              lit: "spells"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
