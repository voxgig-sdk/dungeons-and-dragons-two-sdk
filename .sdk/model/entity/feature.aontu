# Entity: feature

main: kit: entity: feature: {

  alias: field: {}

  fields: {
    class: {
      h: "Class"
      n: "class"
      r: false
      t: "`$OBJECT`"
    }
    desc: {
      h: "Desc"
      n: "desc"
      r: false
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    index: {
      h: "Index"
      n: "index"
      r: false
      sh: "Resource index for the feature"
      t: "`$STRING`"
    }
    level: {
      h: "Level"
      n: "level"
      r: false
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the feature"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "URL to the feature resource"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "feature"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /features"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/features"
          s: [
            {
              lit: "features"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /features/{index}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "index"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/features/{index}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              index: "id"
            }
          }
          s: [
            {
              lit: "features"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
